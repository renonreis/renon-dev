		"@fontsource/barlow-condensed": "5.3.0",
		"@tailwindcss/vite": "4.3.5",
		"astro": "7.4.13",
		"gsap": "3.15.1",
		"lenis": "1.3.27",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.5"
	},
	"private": true,
	"packageManager": "pnpm@12.21.0",
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@biomejs/biome": "2.6.8",
