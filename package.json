{
	"name": "renon-dev",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24.22.3"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "biome check",
