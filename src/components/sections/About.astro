---
import { getContent } from "../../i18n/content";
import type { Locale } from "../../i18n/routes";
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import { shellHeights } from "./shell-heights";

// Shell from spec 0004: heading and reserved height only. Feature 9 builds the content.
interface Props {
	locale: Locale;
}

const { about } = getContent(Astro.props.locale);
---

<Section id="about" headingId="about-title" minHeight={shellHeights.about}>
	<SectionHeading id="about-title" title={about.title} eyebrow={about.eyebrow} accent="violet" />
</Section>
