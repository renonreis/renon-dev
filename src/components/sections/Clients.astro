---
import { getContent } from "../../i18n/content";
import type { Locale } from "../../i18n/routes";
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import { shellHeights } from "./shell-heights";

// Shell from spec 0004: heading and reserved height only. Feature 10 builds the content.
interface Props {
	locale: Locale;
}

const { clients } = getContent(Astro.props.locale);
---

<Section id="clients" headingId="clients-title" minHeight={shellHeights.clients}>
	<SectionHeading id="clients-title" title={clients.title} />
</Section>
