---
import { getContent } from "../../i18n/content";
import type { Locale } from "../../i18n/routes";
import Section from "../Section.astro";
import SectionHeading from "../SectionHeading.astro";
import { shellHeights } from "./shell-heights";

// Shell from spec 0004: heading and reserved height only. Feature 7 builds the content.
interface Props {
	locale: Locale;
}

const { work } = getContent(Astro.props.locale);
---

<Section id="work" headingId="work-title" minHeight={shellHeights.work}>
	<SectionHeading id="work-title" title={work.title} eyebrow={work.eyebrow} accent="coral" />
</Section>
