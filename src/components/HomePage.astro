---
import type { Locale } from "../i18n/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import Hero from "./sections/Hero.astro";

// The one page body both language routes render, so `/` and `/pt/` share the same sections and ids.
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout locale={locale}>
	<header class="mx-auto flex max-w-content justify-end px-3 py-2 desktop:px-8">
		<LanguageSwitch locale={locale} />
	</header>
	<main class="mx-auto flex max-w-content flex-col px-3 py-12 desktop:px-8">
		<Hero locale={locale} />
	</main>
</BaseLayout>
