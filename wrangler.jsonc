// Spec 0002: renon.dev is served as Workers static assets. Workers Builds runs `pnpm build`, then deploys dist/.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "renon-dev",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": { "enabled": false }
}
